{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sekaipop-launcher",
  "version": "0.1.0",
  "identifier": "com.blapples.sekaipop.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SekaiPop Launcher",
        "url": "index.html",
        "width": 400,
        "height": 720,
        "x": 760,
        "y": 305,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
